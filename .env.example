# Database (Neon/Supabase/Vercel Postgres)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# GoHighLevel
GHL_API_KEY=pit-xxxxxxxx
GHL_SNAPSHOT_ID=xxxxxxxxxxxx

# Notion
NOTION_API_KEY=secret_xxxxxxxx
NOTION_DATABASE_ID=32chardatabaseidwithoutthehyphens

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# Firecrawl (website scraping -> GHL KB)
FIRECRAWL_API_KEY=fc-xxxxxxxx

# Webhook auth (shared secret for CRM webhooks)
WEBHOOK_SECRET=change_this_to_a_long_random_string

# Optional: Slack/Discord webhook for new-client notifications
TEAM_NOTIFICATION_WEBHOOK=

# Optional: DRY_RUN=true skips real GHL/Stripe API calls (use for smoke tests)
DRY_RUN=
